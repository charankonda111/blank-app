# Copy to .env.local for local development, and add the same values in your host's
# environment settings (Vercel / Netlify). Leave the Supabase values empty to run in
# local-only mode (no login, data stays in the browser).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" after enabling Google in Supabase → Authentication → Providers
VITE_GOOGLE_AUTH=false

# Prices shown on the upgrade screen (the real prices live in Stripe)
VITE_PRICE_MONTHLY_LABEL=$4.99
VITE_PRICE_YEARLY_LABEL=$39.99
