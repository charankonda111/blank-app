# Edge Function secrets. Set them in production with:
#   supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env first; that file is git-ignored)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# Your live site, e.g. https://lost2med.vercel.app (checkout/portal only redirect here)
SITE_URL=

# Stripe → Developers → API keys (use sk_test_... until you're ready to launch)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Stripe → Product catalog → Lost2Med Pro → the two price IDs
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# "true" once Stripe Tax is set up for GST/HST
STRIPE_AUTOMATIC_TAX=false

# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# AI requests per user per day
AI_DAILY_LIMIT=40
